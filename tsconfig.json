{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "./types/global.d.ts",
    "./types/svg.type.d.ts",
    "expo-env.d.ts",
    "metro.config.js"
  ],
  
}